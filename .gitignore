# Renders — commit the cue sheets and settings, not the output files
*.mp3
*.wav
*.m4a
*.aac
*.mp4
*.mov

# Episode working directories, when they land here
_upload/

# Hook scratch — context_watch.py records which thresholds it has already fired
.claude/state/

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db
desktop.ini

# Episode working directories and pipeline state — real episodes get committed
# deliberately; smoke-test runs do not.
episodes/*/state.json
memory/

# Generated frames. The manifest is queue state, the PNGs are renders —
# neither belongs in git. `generate_frames.py status` rebuilds progress from
# whatever is on disk.
output/
